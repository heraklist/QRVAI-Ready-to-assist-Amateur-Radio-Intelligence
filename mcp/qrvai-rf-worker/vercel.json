{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 30,
      "includeFiles": "src/**/*"
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    }
  ]
}
